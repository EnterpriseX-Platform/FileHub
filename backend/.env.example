# ──────────────────────────────────────────────────────────────────────────────
# File Hub backend — example env file.
#
# Copy to backend/.env (which is gitignored) and fill in the values that are
# marked REQUIRED in release.  Debug builds (`cargo run`) keep dev-friendly
# fallbacks; release builds (`cargo build --release`) refuse to boot until
# the REQUIRED vars are set.
# ──────────────────────────────────────────────────────────────────────────────

# REQUIRED — Postgres connection string.
# In docker-compose the default user/pass/db are all `filehub` — change them
# for any environment a human can reach.
DATABASE_URL=postgresql://USER:PASS@HOST:5432/DB

# Port the Axum server binds (0.0.0.0:$PORT).  Defaults to 8090.
PORT=8090

# Filesystem backend root.  Honoured when STORAGE_BACKEND=fs (the default).
STORAGE_ROOT=./storage

# Optional — pick the object-store backend.  `fs` writes to STORAGE_ROOT,
# `s3` talks to any S3-compatible service via the env block below.
# STORAGE_BACKEND=fs

# Optional but STRONGLY RECOMMENDED — 32-byte hex key enabling AES-256-GCM
# at-rest encryption.  Generate with:  openssl rand -hex 32
# WARNING: backups MUST also capture this key.  Without it the on-disk
# ciphertexts are permanently unreadable.  See scripts/backup.sh.
#
# Key rotation: there is no in-place key rotation.  Today, changing this
# value makes every existing object unreadable — re-encrypt out of band by
# downloading + re-uploading every file or just keep the same key for the
# life of the deployment.
STORAGE_ENC_KEY=

# REQUIRED — exact browser-facing origin allowed via CORS.  Must match the
# scheme/host/port the frontend serves from (e.g. https://files.example.com).
# Wildcards are NOT supported; cookies require a precise origin.
CORS_ORIGIN=http://localhost:3001

# REQUIRED — HMAC secret used to sign Collabora WOPI access tokens.
# Anyone with this key can mint edit tokens for any file: treat it like a
# database password.  Generate with:  openssl rand -hex 32
WOPI_SECRET=

# Whether session cookies are marked `Secure` (only sent over HTTPS).
# Default ON — set false for plain-http local dev only.
COOKIE_SECURE=true

# Postgres connection pool tuning.  Defaults shown.
# DATABASE_MAX_CONNECTIONS=32
# DATABASE_ACQUIRE_TIMEOUT_SECS=30
# DATABASE_IDLE_TIMEOUT_SECS=600

# Rotation worker cadence.  Set to 0 to disable.
# ROTATION_INTERVAL_SECS=3600

# tracing-subscriber filter.
RUST_LOG=info,filehub_backend=debug,tower_http=info
