# ──────────────────────────────────────────────────────────────────────────────
# File Hub backend — example env file.
#
# Copy to backend/.env (which is gitignored) and fill in the values that are
# marked REQUIRED in release.  Debug builds (`cargo run`) keep dev-friendly
# fallbacks; release builds (`cargo build --release`) refuse to boot until
# the REQUIRED vars are set.
# ──────────────────────────────────────────────────────────────────────────────

# REQUIRED — Postgres connection string.
# In docker-compose the default user/pass/db are all `filehub` — change them
# for any environment a human can reach.
DATABASE_URL=postgresql://USER:PASS@HOST:5432/DB

# Port the Axum server binds (0.0.0.0:$PORT).  Defaults to 8090.
PORT=8090

# Filesystem backend root.  Honoured when STORAGE_BACKEND=fs (the default).
STORAGE_ROOT=./storage

# Optional — pick the object-store backend.  `fs` writes to STORAGE_ROOT,
# `s3` talks to any S3-compatible service (AWS S3, MinIO, Wasabi, R2…) via
# the S3_* block below.
# STORAGE_BACKEND=fs

# ── S3 / MinIO backend ────────────────────────────────────────────────────
# Honoured only when STORAGE_BACKEND=s3.  The values below match the MinIO
# service in docker-compose.yml, so `docker compose up -d minio minio-setup`
# + STORAGE_BACKEND=s3 is a working local setup out of the box.
#
# S3_ENDPOINT — base URL of the S3 API.  For the bundled MinIO use
#   http://localhost:9000 when the backend runs on the host, or
#   http://minio:9000 when the backend itself runs inside the compose network.
#   For AWS:  https://s3.<region>.amazonaws.com
# S3_PATH_STYLE — MinIO needs path-style (endpoint/bucket/key); leave true.
#   Set false only for providers that require virtual-hosted-style (bucket.host).
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_BUCKET=filehub-storage
# S3_ACCESS_KEY=filehub
# S3_SECRET_KEY=filehub-minio-dev
# S3_PATH_STYLE=true

# Optional but STRONGLY RECOMMENDED — 32-byte hex key enabling AES-256-GCM
# at-rest encryption.  Generate with:  openssl rand -hex 32
# WARNING: backups MUST also capture this key.  Without it the on-disk
# ciphertexts are permanently unreadable.  See scripts/backup.sh.
#
# Key rotation: there is no in-place key rotation.  Today, changing this
# value makes every existing object unreadable — re-encrypt out of band by
# downloading + re-uploading every file or just keep the same key for the
# life of the deployment.
STORAGE_ENC_KEY=

# REQUIRED — exact browser-facing origin allowed via CORS.  Must match the
# scheme/host/port the frontend serves from (e.g. https://files.example.com).
# Wildcards are NOT supported; cookies require a precise origin.
CORS_ORIGIN=http://localhost:3001

# REQUIRED — HMAC secret used to sign Collabora WOPI access tokens.
# Anyone with this key can mint edit tokens for any file: treat it like a
# database password.  Generate with:  openssl rand -hex 32
WOPI_SECRET=

# Whether session cookies are marked `Secure` (only sent over HTTPS).
# Default ON — set false for plain-http local dev only.
COOKIE_SECURE=true

# Postgres connection pool tuning.  Defaults shown.
# DATABASE_MAX_CONNECTIONS=32
# DATABASE_ACQUIRE_TIMEOUT_SECS=30
# DATABASE_IDLE_TIMEOUT_SECS=600

# Rotation worker cadence.  Set to 0 to disable.
# ROTATION_INTERVAL_SECS=3600

# Auto-release a check-out lock left held longer than this many hours (the
# rotation worker reaps stale locks each tick). Default 8.
# CHECKOUT_TTL_HOURS=8

# tracing-subscriber filter.
RUST_LOG=info,filehub_backend=debug,tower_http=info

# ──────────────────────────────────────────────────────────────────────────────
# AI-native layer (embeddings + chat). Pluggable, LOCAL-FIRST.
#
# Defaults target a local Ollama (OpenAI-compatible) — fully self-hosted, no
# data egress, no key. The same vars point at any OpenAI-compatible endpoint
# (vLLM, a LiteLLM gateway, OpenAI, Azure OpenAI): just change AI_BASE_URL +
# AI_API_KEY + model names. Set AI_ENABLED=false to disable AI entirely (no
# enrichment worker, /api/search/semantic returns 400) — FileHub then behaves
# exactly as before.
#
# Local quick start:
#   ollama serve
#   ollama pull nomic-embed-text   # 768-dim embeddings (matches the DB column)
#   ollama pull qwen2.5            # summaries / tags
# ──────────────────────────────────────────────────────────────────────────────
AI_ENABLED=true
AI_BASE_URL=http://localhost:11434/v1
# AI_API_KEY=                       # required only for cloud providers
AI_EMBED_MODEL=nomic-embed-text
AI_EMBED_DIM=768                    # MUST match migrations/0016 vector(768)
AI_CHAT_MODEL=qwen2.5
AI_MAX_CONTEXT_TOKENS=8192
AI_TIMEOUT_SECS=120
AI_WORKER_INTERVAL_SECS=15          # enrichment queue poll cadence

# ──────────────────────────────────────────────────────────────────────────────
# OCR (scanned images / image-only PDFs -> searchable Thai+English text).
# Local-first + optional: shells out to Tesseract (images) and pdftoppm/Poppler
# (rasterise PDFs). If those binaries aren't installed, OCR silently no-ops.
#   Ubuntu:  apt-get install tesseract-ocr tesseract-ocr-tha poppler-utils
# OCR runs in the background after upload and indexes the text for full-text
# search (and feeds the AI layer when enabled).
# ──────────────────────────────────────────────────────────────────────────────
OCR_ENABLED=true
OCR_LANGS=tha+eng                   # Tesseract language packs to load
# OCR_TESSERACT_CMD=tesseract       # override binary path if needed
# OCR_PDFTOPPM_CMD=pdftoppm
# OCR_MAX_PDF_PAGES=30              # cap pages OCR'd per PDF

# ──────────────────────────────────────────────────────────────────────────────
# Outbound email (SMTP) — OPTIONAL, OFF by default. When enabled, in-app
# notifications (e-signature sign-turn, workflow) are mirrored to email.
# No-ops entirely unless MAIL_ENABLED=true AND SMTP_HOST is set.
# ──────────────────────────────────────────────────────────────────────────────
# MAIL_ENABLED=true
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=filehub@example.com
# MAIL_SECURITY=starttls            # starttls | tls | none
# MAIL_BASE_URL=https://filehub.example.com/filehub   # link prefix in emails
